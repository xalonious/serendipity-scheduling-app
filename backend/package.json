{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend for ssc site",
  "license": "ISC",
  "author": "xander",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "initdb": "npx prisma migrate dev --name init",
    "seed": "npx prisma db seed",
    "resetshifts": "ts-node ./src/data/resetAndStoreShifts.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node ./src/data/resetAndSeed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "axios": "^1.9.0",
    "config": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.15.1",
    "noblox.js": "^6.2.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.2",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/moment": "^2.11.29",
