    "@types/node": "^22.15.29",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "prisma": "^6.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
